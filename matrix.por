programa {
  funcao inicio() {
    /*10. A Escolha da Pílula (Matrix)
 
Crie um laço que continue pedindo uma cor ("azul" ou "vermelha") até que o usuário digite "vermelha".*/
     
    cadeia pilula = ""
    enquanto(pilula != "vermelha"){
      escreva("voce esta na matrix. escolha a pilula azul ou vermelha`): ")
      leia(pilula)
    }
  }
}
 